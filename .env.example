# ── App
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ── Models (OpenRouter model IDs)
NEWS_MODEL=openai/gpt-4o-mini
SENTIMENT_MODEL=meta-llama/llama-3.1-8b-instruct
TA_MODEL=anthropic/claude-opus-4-6
RISK_MODEL=openai/gpt-4o-mini

# ── Exchange (Bybit Demo)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_BASE_URL=https://api-demo.bybit.com

# ── News
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# ── Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password

# ── Telegram
TG_TOKEN=your_telegram_bot_token
TG_CHAT_IDS=your_chat_id

# ── Risk Parameters
MAX_RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=3.0
MIN_CONFIDENCE=0.60
MAX_FUNDING_RATE=0.0008
LIVE_TRADING_ENABLED=false
TRAILING_TRIGGER_PCT=0.01
TRAILING_DISTANCE_PCT=0.003
TP1_CLOSE_PCT=0.5

# ── Trading
SYMBOL=BTCUSDT
KLINE_INTERVAL=5
KLINE_LIMIT=200
SCHEDULE_MINUTES=5

# ── Retention
EXECUTIONS_DATA_MAX_AGE=30
